
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Proveedores</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/proveedores.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body class="admin-page">

    <%- include("partials/admin-sidebar", { active: "proveedores" }) %>



    <!-- MAIN -->

    <main class="main-content">


        <!-- HEADER -->

        <div class="top-header">

            <h1>🚚 Proveedores</h1>

            <div class="header-actions">

                <input type="text"
                       id="buscador"
                       placeholder="Buscar proveedor...">

                <button id="btnNuevo">
                    + Nuevo proveedor
                </button>

                <button id="btnNuevoPedido">
                    + Nuevo pedido
                </button>

            </div>

        </div>



        <!-- KPI -->

        <div class="kpi-container">

            <div class="kpi-card" id="cardActivos">

                <h3>Proveedores activos</h3>

                <p>18</p>

            </div>


            <div class="kpi-card" id="cardPendientes">

                <h3>Pedidos pendientes</h3>

                <p>6</p>

            </div>


            <div class="kpi-card" id="cardEntregas">

                <h3>Entregas hoy</h3>

                <p>4</p>

            </div>


            <div class="kpi-card" id="cardDeuda">

                <h3>Deuda total</h3>

                <p>$5.800.000</p>

            </div>

        </div>

        <!-- TABLA -->

        <div class="tabla-container">

            <div class="tabla-header">

                <h2>Lista de proveedores</h2>

                <select id="filtroEstado">

                    <option value="todos">
                        Todos
                    </option>

                    <option value="Activo">
                        Activos
                    </option>

                    <option value="Pendiente">
                        Pendientes
                    </option>

                    <option value="Cancelado">
                        Cancelados
                    </option>

                </select>

            </div>


            <table>

                <thead>

                    <tr>

                        <th>Proveedor</th>

                        <th>Teléfono</th>

                        <th>Pedidos</th>

                        <th>Estado</th>

                        <th>Deuda</th>

                        <th>Acciones</th>

                    </tr>

                </thead>


                <tbody id="tablaProveedores">

                </tbody>

            </table>

        </div>



        <!-- DETALLE PEDIDOS -->

        <div class="detalle-container">

            <h2>
                📦 Pedidos recientes
            </h2>

            <div id="detallePedidos">

            </div>

        </div>



        <!-- DETALLE COMPLETO -->

        <div id="detalleCompleto"></div>


<!-- MODAL -->

<!-- MODAL -->

<div class="modal" id="modalProveedor">

    <div class="modal-content">

        <h2 id="tituloModal">
            Nuevo proveedor
        </h2>

        <form id="formProveedor">

            <input type="hidden" id="id_proveedor">

            <label>
                Nombre del proveedor
            </label>

            <input
                type="text"
                id="nombreProveedor"
                placeholder="Ej: AndesLiquor"
                required
            >

            <label>
                Teléfono
            </label>

            <input
                type="text"
                id="telefonoProveedor"
                placeholder="Ej: 3215559988"
                required
            >

            <label>
                Correo
            </label>

            <input
                type="email"
                id="correoProveedor"
                placeholder="Ej: proveedor@gmail.com"
                required
            >

            <label>
                Dirección
            </label>

            <input
                type="text"
                id="direccionProveedor"
                placeholder="Ej: Calle 80 # 20-30"
            >

            <label>
                Ciudad
            </label>

            <input
                type="text"
                id="ciudadProveedor"
                placeholder="Ej: Bogotá"
            >

            <label>
                NIT
            </label>

            <input
                type="text"
                id="nitProveedor"
                placeholder="Ej: 900123456-7"
            >

            <label>
                Contacto principal
            </label>

            <input
                type="text"
                id="contactoProveedor"
                placeholder="Nombre del contacto"
            >

            <label>
                Notas
            </label>

            <textarea
                id="notasProveedor"
                placeholder="Información adicional del proveedor"
            ></textarea>

            <div class="modal-actions">

                <button
                    type="button"
                    id="cerrarModal"
                    class="btn-secondary">
                    Cancelar
                </button>

                <button
                    type="submit"
                    id="guardarProveedor"
                    class="btn-primary">
                    Guardar
                </button>

            </div>

        </form>

    </div>

</div>
<!-- MODAL NUEVO PEDIDO -->

<div class="modal" id="modalPedido">

    <div class="modal-content">

        <h2>Nuevo pedido al proveedor</h2>

        <form id="formPedido">

            <label>Proveedor</label>

            <select id="pedidoProveedor" required>
                <option value="">Seleccionar proveedor</option>
            </select>
<div class="form-grid">

    <div>
        <label>Producto</label>

        <select id="pedidoProducto">
            <option value="">
                Seleccionar producto
            </option>
        </select>
    </div>

    <div>
        <label>Cantidad</label>

        <input
            type="number"
            id="pedidoCantidad"
            min="1"
            value="1"
        >
    </div>

</div>

<button
    type="button"
    id="btnAgregarProductoPedido"
    class="btn-secondary">

    + Agregar producto

</button>

            <div id="productosPedido">

                <!-- Aquí aparecerán los productos -->

            </div>

            <label>Observaciones</label>

            <textarea
                id="pedidoObservaciones"
                placeholder="Observaciones del pedido">
            </textarea>

            <div class="modal-actions">

                <button
                    type="button"
                    id="cerrarModalPedido"
                    class="btn-secondary">
                    Cancelar
                </button>

                <button
                    type="submit"
                    class="btn-primary">
                    Crear pedido
                </button>

            </div>

        </form>

    </div>

</div>

<script src="/js/config.js"></script>
<script src="/js/sidebar.js"></script>

<script src="/js/proveedores.js"></script>
