<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inicio - BacoApp</title>

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/inicio.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="inicio-page">
  <script src="/js/theme.js"></script>
  <%
  const masVendidosLista =
    typeof masVendidos !== "undefined" &&
    Array.isArray(masVendidos)
    ? masVendidos
    : [];
    const productosLista = typeof productos !== "undefined" && Array.isArray(productos) ? productos : [];
    const ofertasLista = typeof ofertas !== "undefined" && Array.isArray(ofertas)
      ? ofertas.filter(oferta => oferta && oferta.titulo)
      : [];
  %>

  <button id="menu-btn" class="menu-btn" aria-label="Abrir menu">
    <i class="fa-solid fa-bars"></i>
  </button>

  <div id="overlay" class="overlay"></div>

  <aside id="sidebar" class="sidebar">
    <div class="sidebar-top">
      <h2 class="brand">BacoApp</h2>
      <button id="close-btn" class="close-btn" aria-label="Cerrar menu">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <nav class="nav">
      <ul>
        <li class="active"><a href="/Inicio"><i class="fa-solid fa-house"></i> Inicio</a></li>
        <li><a href="/Categorias"><i class="fa-solid fa-wine-bottle"></i> Categorias</a></li>
        <li><a href="#carrito"><i class="fa-solid fa-cart-shopping"></i> Carrito <span data-cart-count>0</span></a></li>
        <li><a href="/Cuenta"><i class="fa-solid fa-user"></i> Cuenta</a></li>
        <li><a href="/Index"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesion</a></li>
      </ul>
    </nav>
  </aside>

  <aside id="cart-sidebar" class="cart-sidebar">
    <button class="close-cart" aria-label="Cerrar carrito">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <h2>Tu Carrito</h2>
    <div class="cart-items">
      <div id="carrito-contenido"></div>
    </div>
    <div class="cart-actions">
      <p id="total-price">Total: $0</p>
      <a class="cart-page-link" href="/carrito"><i class="fa-solid fa-up-right-from-square"></i> Ver carrito completo</a>
      <button id="btn-pagar">Pagar</button>
      <button id="btn-vaciar">Vaciar Carrito</button>
      <button id="btn-seguir">Seguir Comprando</button>
    </div>
  </aside>

  <main class="inicio-shell">
    <section class="hero-tienda">
      <div class="hero-copy">
        <span class="hero-kicker">Tienda BacoApp</span>
        <h1>Las mejores ofertas en licores y antojos para celebrar.</h1>
        <p>Busca, compara y agrega al carrito desde una sola pagina de inicio.</p>
      </div>

      <form class="search" role="search">
        <label for="product-search">Buscar productos</label>
        <div class="search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input id="product-search" type="search" placeholder="Whisky, ron, cerveza..." autocomplete="off">
          <button type="button" id="clear-search" aria-label="Limpiar busqueda">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </form>
    </section>

    <section class="featured-strip" aria-label="Promociones destacadas">
      <article>
        <span>Hoy</span>
        <strong>Promociones especiales</strong>
      </article>
      <article>
        <span>Entrega</span>
        <strong>Carrito listo en segundos</strong>
      </article>
      <article>
        <span>Catalogo</span>
        <strong>Todo desde Inicio</strong>
      </article>
    </section>

 
<!-- tarjetas de promociones -->
  <section class="promo-section">
  <div class="section-heading">
    <div>
      <h2>Ofertas del día</h2>
      <p>Las promociones de tienda también viven aquí.</p>
    </div>
  </div>

  <div class="promociones">

  

  <% if (ofertas && ofertas.length > 0) { %>

    <% ofertas.forEach(oferta => { %>

       <div class="producto-grid">

        <div class="producto-card">

            <!-- AQUÍ VA LA IMAGEN -->
            <div class="producto-imagen">

                <% if (oferta.imagen) { %>

                    <img
                        src="http://localhost:3000<%= oferta.imagen %>"
                        alt="<%= oferta.nombre %>"
                    >

                <% } else { %>

                    <div class="sin-imagen">
                        <i class="fa-solid fa-image"></i>
                        <span>Sin imagen</span>
                    </div>

                <% } %>

            </div>

            <!-- AQUÍ VA LA INFORMACIÓN -->
            <div class="producto-info">

                <h2><%= oferta.producto %></h2>

                <p>Precio: $<%= oferta.precio %></p>

                <p>Precio de oferta: $<%= Number(oferta.precio_oferta).toLocaleString("es-CO") %></p>

                <p>Stock: <%= oferta.stock %></p>

<div class="btn-agregar">
    <button
        class="btn-agregar"
        data-id="<%= oferta.id_producto %>"
        data-nombre="<%= oferta.producto %>"
        data-precio="<%= oferta.precio_oferta %>"
    >
        Agregar al carrito
    </button>
</div>

<div class="btn-detalles">

    <button
        type="button"
        class="btn-ver-mas"
        data-id-producto="<%= oferta.id_producto %>"
    >
        Ver detalles
    </button>

</div>
                  
                </div>

            </div>

        </div>

    <% }) %>

<% } %>

  </div>
</section>

<!-- =========================
     QUIÉNES SOMOS
========================== -->

<section class="quienes-somos">

    <div class="quienes-somos-contenido">

        <div class="quienes-somos-icono">
            <i class="fa-solid fa-wine-glass"></i>
        </div>

        <div class="quienes-somos-texto">

            <span class="seccion-etiqueta">
                CONOCE BACOAPP
            </span>

            <h2>
                ¿Quiénes somos?
            </h2>

            <p>
                BacoApp es una plataforma diseñada para facilitar la
                compra y gestión de productos de una licorera de forma
                rápida, sencilla y segura.
            </p>

            <p>
                Queremos ofrecer una experiencia cómoda para nuestros
                clientes, permitiéndoles explorar nuestro catálogo,
                conocer nuestras ofertas y realizar sus compras desde
                un solo lugar.
            </p>

        </div>

    </div>

</section>

<!-- =========================
     MISIÓN
========================== -->

<section class="mision">

    <div class="mision-contenido">

        <div class="mision-texto">

            <span class="seccion-etiqueta">
                NUESTRA MISIÓN
            </span>

            <h2>
                Facilitar una mejor experiencia de compra
            </h2>

            <p>
                Nuestra misión es ofrecer a nuestros clientes una
                plataforma sencilla, rápida y segura para consultar
                productos, conocer ofertas y realizar sus compras
                de manera cómoda.
            </p>

            <p>
                Buscamos apoyar la gestión de la licorera mediante
                herramientas digitales que permitan organizar mejor
                los productos, las ventas y la atención a nuestros
                clientes.
            </p>

        </div>

        <div class="mision-icono">
            <i class="fa-solid fa-bullseye"></i>
        </div>

    </div>

</section>

<!-- =========================
     VISIÓN
========================== -->

<section class="vision">

    <div class="vision-contenido">

        <div class="vision-icono">
            <i class="fa-solid fa-eye"></i>
        </div>

        <div class="vision-texto">

            <span class="seccion-etiqueta">
                NUESTRA VISIÓN
            </span>

            <h2>
                Ser una plataforma de referencia para nuestros clientes
            </h2>

            <p>
                Nuestra visión es convertir a BacoApp en una herramienta
                confiable y práctica para la gestión y compra de productos
                de la licorera.
            </p>

            <p>
                Queremos continuar mejorando la experiencia de nuestros
                clientes mediante soluciones digitales que faciliten el
                acceso a nuestros productos y servicios.
            </p>

        </div>

    </div>

</section>

<div id="modal-producto" class="modal">

    <div class="modal-content">

        <span class="cerrar">&times;</span>

        <h2>Información del producto</h2>

        <div class="info-producto">

            <p>
                <strong>ID:</strong>
                <span id="detalle-id"></span>
            </p>

            <p>
                <strong>Nombre:</strong>
                <span id="detalle-nombre"></span>
            </p>

            <p>
                <strong>Descripción:</strong>
                <span id="detalle-descripcion"></span>
            </p>

            <p>
                <strong>Precio:</strong> $
                <span id="detalle-precio"></span>
            </p>

            <p>
                <strong>Stock:</strong>
                <span id="detalle-stock"></span>
            </p>

            <p>
                <strong>Categoría:</strong>
                <span id="detalle-categoria"></span>
            </p>

            <p>
                <strong>Marca:</strong>
                <span id="detalle-marca"></span>
            </p>

            <p>
                <strong>Tipo:</strong>
                <span id="detalle-tipo"></span>
            </p>

            <p>
                <strong>País:</strong>
                <span id="detalle-pais"></span>
            </p>

        </div>

    </div>

</div>
<section class="info-section objetivos-section">

    <div class="info-icon">
        <i class="fa-solid fa-bullseye"></i>
    </div>

    <div class="info-content">

       <span class="seccion-etiquetas">
                NUESTROS OBJETIVOS
        </span>

        <h2>Objetivos</h2>

        <p>
            Nuestro objetivo es ofrecer una plataforma digital que facilite
            la gestión y comercialización de productos de una licorera,
            brindando una experiencia sencilla, rápida y segura para nuestros
            clientes.
        </p>

        <div class="objetivos-grid">

            <div class="objetivo-item">
                <i class="fa-solid fa-store"></i>
                <div>
                    <h3>Facilitar la compra</h3>
                    <p>
                        Permitir que los clientes puedan explorar productos,
                        consultar ofertas y realizar sus compras de manera
                        sencilla.
                    </p>
                </div>
            </div>

            <div class="objetivo-item">
                <i class="fa-solid fa-boxes-stacked"></i>
                <div>
                    <h3>Mejorar la gestión</h3>
                    <p>
                        Ayudar a administrar productos, inventario, ventas,
                        clientes y ofertas desde una sola plataforma.
                    </p>
                </div>
            </div>

            <div class="objetivo-item">
                <i class="fa-solid fa-chart-line"></i>
                <div>
                    <h3>Impulsar el crecimiento</h3>
                    <p>
                        Proporcionar herramientas que permitan conocer el
                        comportamiento de las ventas y apoyar la toma de
                        decisiones.
                    </p>
                </div>
            </div>

            <div class="objetivo-item">
                <i class="fa-solid fa-shield-halved"></i>
                <div>
                    <h3>Brindar seguridad</h3>
                    <p>
                        Mantener una plataforma confiable para la gestión de
                        información, usuarios y operaciones de BacoApp.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>
  </main>

  <script src="/js/sidebar.js"></script>
  <script src="/js/inicio.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>
