<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0"
    >

    <title>Reportes</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/reportes.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body class="admin-page">

    <%- include("partials/admin-sidebar", { active: "reportes" }) %>



    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main class="main-content">


        <!-- =========================
             HEADER
        ========================== -->

        <div class="top-header">

            <h1>📈 Reportes</h1>

            <div class="admin">
                👤 Administrador
            </div>

        </div>



        <!-- =========================
             CARDS PRINCIPALES
        ========================== -->

        <div class="reportes-cards">

            <div class="reporte-card" id="cardVentas">

                <h3>Ventas del mes</h3>

                <p id="ventasMes">$0</p>

            </div>


            <div class="reporte-card" id="cardProductos">

                <h3>Productos vendidos</h3>

                <p id="productosVendidos">0</p>

            </div>


            <div class="reporte-card" id="cardGanancias">

                <h3>Ganancias</h3>

                <p>$2.300.000</p>

            </div>


            <div class="reporte-card" id="cardTop">

                <h3>Producto top</h3>

                <p id="productoTop">Sin ventas</p>

            </div>

        </div>



        <!-- =========================
             KPI CARDS
        ========================== -->

        <div class="kpi-container">


           <div class="kpi-card" id="kpiMejorVendedor">

                <h3>🏆 Mejor vendedor</h3>

                <p id="mejorVendedor">
                     Sin ventas
                </p>

                <span id="ventasMejorVendedor">
                    0 ventas este mes
                </span>

            </div>


    <div class="kpi-card" id="kpiProductoTop">

        <h3>🥃 Producto top semanal</h3>

        <p id="productoTopSemanal">
            Sin ventas
        </p>

        <span id="unidadesProductoTop">
            0 unidades vendidas
        </span>

    </div>



            <div class="kpi-card" id="kpiClientesNuevos">

                <h3>👥 Clientes nuevos</h3>

                <p id="clientesNuevos">0</p>

                <span>
                    registrados este mes
                </span>

            </div>

        </div>



        <!-- =========================
             GRAFICA
        ========================== -->
<div class="grafica-container">

    <h2>Ventas semanales</h2>

    <div class="grafica">

        <div class="dia">
            <div class="barra"></div>
            <span>Lun</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Mar</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Mié</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Jue</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Vie</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Sáb</span>
        </div>

        <div class="dia">
            <div class="barra"></div>
            <span>Dom</span>
        </div>

    </div>

</div>



       

        <div class="detalle-reportes">

            <h2 id="tituloReporte">
                Detalle del reporte
            </h2>

            <div id="listaReportes">

            </div>

        </div>



        <!-- =========================
             TABLA
        ========================== -->

        <div class="tabla-container">

    <h2>Últimas ventas</h2>

    <table>

        <thead>

            <tr>

                <th>Producto</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>

            </tr>

        </thead>

        <tbody id="ultimasVentas">

        </tbody>

    </table>

</div>

    <script src="/js/config.js"></script>
<script src="/js/sidebar.js"></script>
    <script src="/js/reportes.js"></script>

</body>

</html>
