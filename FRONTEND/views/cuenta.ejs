<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuenta - BacoApp</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

<%- include("partials/client-sidebar", { active: "cuenta" }) %>



<main class="cuenta-container">
    <section class="account-hero">
        <div class="profile-card">
            <div class="profile-avatar" aria-hidden="true">
                <img src="/img/logo_bacoapp.png" alt="BacoApp">
            </div>
            <div>
                <span class="account-kicker">Cuenta cliente</span>
              
                <h1 id="profileName"><%= usuario.nombre || "Mi cuenta" %></h1>
                <p id="profileTier"><%= usuario.rol === "admin" ? "Administrador" : "Cliente" %></p>
                  <P>cliente
                    <strong><%= usuario.nivel %></strong>
                </P>
                
            </div>
        </div>

        <div class="hero-actions">
            <a class="btn-outline" href="/carrito">
                <i class="fa-solid fa-cart-shopping"></i>
                Ver carrito
                <span data-cart-count>0</span>
            </a>
            <button class="btn-editar-perfil" id="editProfile" type="button">
                <i class="fa-solid fa-pen"></i>
                Editar perfil
            </button>
        </div>
    </section>

    <section class="account-dashboard">


        <article class="metric-card">
            <i class="fa-solid fa-crown"></i>
            <span>Nivel</span>
            <strong><%= usuario.nivel || "Bronce" %></strong>
        </article>

        <article class="metric-card">
            <i class="fa-solid fa-wallet"></i>
            <span>Total gastado</span>
            <strong>
                $<%= Number(usuario.totalGastado || 0).toLocaleString("es-CO") %>
            </strong>
        </article>

        <article class="metric-card">
            <i class="fa-solid fa-user-check"></i>
            <span>Estado</span>
            <strong><%= usuario.estado %></strong>
        </article>

        <article class="metric-card">
            <i class="fa-solid fa-credit-card"></i>
            <span>Cupo</span>
            <strong>
                $<%= Number(usuario.cupoCredito || 0).toLocaleString("es-CO") %>
            </strong>
        </article>

    </section>

    <section class="cuenta-grid">
        <article class="card-cuenta account-main">
            <div class="card-header">
                <div>
                    <h2>Informacion personal</h2>
                    <p>Datos principales para compras y entregas.</p>
                </div>
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="form-grid">
                <div class="campo">
                    <label for="accountName">Nombre</label>
                    <input type="text" id="accountName" value="<%= usuario.nombre || "" %>">
                </div>

                <div class="campo">
                    <label for="accountEmail">Email</label>
                    <input type="email" id="accountEmail" value="<%= usuario.email || "" %>">
                </div>

                <div class="campo">
                    <label for="accountPhone">Telefono</label>
                    <input type="text" id="accountPhone" value="<%= usuario.telefono || "" %>">
                </div>

                <div class="campo">
                    <label for="accountDocument">Documento</label>
                    <input type="text" id="accountDocument" value="<%= usuario.documento || "" %>">
                </div>

                <div class="campo campo-full">
                    <label for="accountAddress">Direccion</label>
                    <input type="text" id="accountAddress" value="<%= usuario.direccion || "" %>">
                </div>
            </div>

            <button class="btn-guardar" id="saveAccount" type="button">
                <i class="fa-solid fa-floppy-disk"></i>
                Guardar cambios
            </button>
        </article>

        <article class="card-cuenta">
            <div class="card-header">
                <div>
                    <h2>Apariencia</h2>
                    <p>Personaliza tu experiencia.</p>
                </div>
                <i class="fa-solid fa-palette"></i>
            </div>

            <div class="theme-selector" id="clientThemeSelector">
                <button type="button" data-theme-option="dark"><span class="swatch dark"></span> Oscuro</button>
                <button type="button" data-theme-option="gold"><span class="swatch gold"></span> Dorado</button>
                <button type="button" data-theme-option="neon"><span class="swatch neon"></span> Neon</button>
                <button type="button" data-theme-option="minimal"><span class="swatch minimal"></span> Minimal</button>
            </div>
        </article>

    </section>
</main>

<script src="/js/cart.js"></script>
<script src="/js/config.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/js/cuenta.js"></script>

</body>
</html>
